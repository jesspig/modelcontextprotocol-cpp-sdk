if(NOT DEFINED COMPAT_COMPILER)
    message(FATAL_ERROR "compat smoke: COMPAT_COMPILER is not set")
endif()
if(NOT DEFINED COMPAT_SOURCE)
    message(FATAL_ERROR "compat smoke: COMPAT_SOURCE is not set")
endif()
if(NOT DEFINED COMPAT_INCLUDE_DIR)
    message(FATAL_ERROR "compat smoke: COMPAT_INCLUDE_DIR is not set")
endif()
if(NOT DEFINED COMPAT_ALLOWLIST)
    message(FATAL_ERROR "compat smoke: COMPAT_ALLOWLIST is not set")
endif()
if(NOT DEFINED COMPAT_RUNTIME)
    message(FATAL_ERROR "compat smoke: COMPAT_RUNTIME is not set")
endif()

if(COMPAT_COMPILER_ID STREQUAL "MSVC")
    set(_compat_flags /nologo /W0 /std:c++17 /EHsc /Zs)
    set(_compat_include "/I${COMPAT_INCLUDE_DIR}")
    set(_compat_define "/D")
elseif(COMPAT_SIMULATE_ID STREQUAL "MSVC")
    set(_compat_flags /nologo /W0 /std:c++17 /EHsc -fsyntax-only)
    set(_compat_include "/I${COMPAT_INCLUDE_DIR}")
    set(_compat_define "/D")
else()
    set(_compat_flags -std=c++17 -fsyntax-only -w)
    set(_compat_include "-I${COMPAT_INCLUDE_DIR}")
    set(_compat_define "-D")
endif()

function(compat_compile out_result out_output probe_macro)
    set(_args ${_compat_flags} "${_compat_include}")
    if(NOT probe_macro STREQUAL "")
        list(APPEND _args "${_compat_define}MCP_COMPAT_PROBE_MODE=1")
        list(APPEND _args "${_compat_define}${probe_macro}=1")
    endif()
    list(APPEND _args "${COMPAT_SOURCE}")
    execute_process(
        COMMAND "${COMPAT_COMPILER}" ${_args}
        RESULT_VARIABLE _result
        OUTPUT_VARIABLE _stdout
        ERROR_VARIABLE _stderr)
    set(${out_result} "${_result}" PARENT_SCOPE)
    set(${out_output} "${_stdout}\n${_stderr}" PARENT_SCOPE)
endfunction()

file(STRINGS "${COMPAT_SOURCE}" _source_lines)
set(_probe_macros "")
foreach(_line IN LISTS _source_lines)
    string(REGEX MATCHALL "MCP_COMPAT_PROBE_[A-Za-z0-9_]+" _found "${_line}")
    list(APPEND _probe_macros ${_found})
endforeach()
list(REMOVE_DUPLICATES _probe_macros)
list(REMOVE_ITEM _probe_macros "MCP_COMPAT_PROBE_MODE")
if(_probe_macros STREQUAL "")
    message(FATAL_ERROR "compat smoke: no MCP_COMPAT_PROBE_* probes found in ${COMPAT_SOURCE}")
endif()

file(STRINGS "${COMPAT_ALLOWLIST}" _allow_lines)
set(_allowed "")
foreach(_line IN LISTS _allow_lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
        continue()
    endif()
    string(REGEX MATCH "^[A-Za-z0-9_]+" _id "${_line}")
    if(_id STREQUAL "")
        message(FATAL_ERROR "compat smoke: invalid allowlist line: ${_line}")
    endif()
    list(APPEND _allowed "${_id}")
endforeach()
list(REMOVE_DUPLICATES _allowed)
if(_allowed STREQUAL "")
    message(FATAL_ERROR "compat smoke: allowlist is empty: ${COMPAT_ALLOWLIST}")
endif()

compat_compile(_baseline_result _baseline_output "")
if(NOT _baseline_result EQUAL 0)
    message(FATAL_ERROR "compat smoke: baseline translation unit failed to compile\n${_baseline_output}")
endif()
message(STATUS "compat smoke: baseline translation unit compiled")

set(_probe_ids "")
foreach(_macro IN LISTS _probe_macros)
    string(LENGTH "MCP_COMPAT_PROBE_" _prefix_length)
    string(SUBSTRING "${_macro}" ${_prefix_length} -1 _id)
    list(APPEND _probe_ids "${_id}")
    list(FIND _allowed "${_id}" _allowed_index)
    compat_compile(_probe_result _probe_output "${_macro}")
    if(_probe_result EQUAL 0)
        if(NOT _allowed_index EQUAL -1)
            message(FATAL_ERROR "compat smoke: allowlisted break '${_id}' now compiles; update expected_breaks.txt")
        endif()
        message(STATUS "compat smoke: probe ${_id} compiled")
    else()
        if(_allowed_index EQUAL -1)
            message(FATAL_ERROR "compat smoke: unexpected compile failure in probe '${_id}'\n${_probe_output}")
        endif()
        string(STRIP "${_probe_output}" _probe_output)
        string(REGEX MATCHALL "[^\n]*error:[^\n]*" _error_lines "${_probe_output}")
        if(_error_lines STREQUAL "")
            string(REGEX REPLACE "\n.*" "" _first_line "${_probe_output}")
        else()
            list(GET _error_lines 0 _first_line)
        endif()
        message(STATUS "compat smoke: expected break ${_id}: ${_first_line}")
    endif()
endforeach()

foreach(_id IN LISTS _allowed)
    list(FIND _probe_ids "${_id}" _probe_index)
    if(_probe_index EQUAL -1)
        message(FATAL_ERROR "compat smoke: allowlist entry '${_id}' has no probe in previous_public_api.cpp")
    endif()
endforeach()

execute_process(
    COMMAND "${COMPAT_RUNTIME}"
    RESULT_VARIABLE _runtime_result
    OUTPUT_VARIABLE _runtime_stdout
    ERROR_VARIABLE _runtime_stderr)
message(STATUS "${_runtime_stdout}${_runtime_stderr}")
if(NOT _runtime_result EQUAL 0)
    message(FATAL_ERROR "compat smoke: runtime checks failed with exit code ${_runtime_result}")
endif()

list(LENGTH _allowed _allowed_count)
message(STATUS "compat smoke: ${_allowed_count} known breaks allowlisted; baseline and runtime checks passed")
